{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_OPENROUTER_MODEL": "google/gemini-3-flash-preview",
        "EXPO_PUBLIC_OPENROUTER_REFERER": "https://antichud.local",
        "EXPO_PUBLIC_OPENROUTER_TITLE": "Antichud"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_OPENROUTER_MODEL": "google/gemini-3-flash-preview",
        "EXPO_PUBLIC_OPENROUTER_REFERER": "https://antichud.local",
        "EXPO_PUBLIC_OPENROUTER_TITLE": "Antichud"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_OPENROUTER_MODEL": "google/gemini-3-flash-preview",
        "EXPO_PUBLIC_OPENROUTER_REFERER": "https://antichud.local",
        "EXPO_PUBLIC_OPENROUTER_TITLE": "Antichud"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
