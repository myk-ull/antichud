{
  "expo": {
    "name": "Antichud",
    "slug": "antichud",
    "scheme": "antichud",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antichud.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Antichud uses your camera to photograph meals so the AI can estimate energy in kilojoules.",
        "NSPhotoLibraryUsageDescription": "Antichud needs access to your photos so you can attach meal images to log entries.",
        "NSPhotoLibraryAddUsageDescription": "Antichud may save annotated meal photos back to your photo library.",
        "NSUserNotificationsUsageDescription": "Antichud uses notifications to remind you to log meals.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.antichud.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0a0a0a",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Antichud needs access to your photos so you can attach meal images to log entries.",
          "cameraPermission": "Antichud uses your camera to photograph meals so the AI can estimate energy in kilojoules."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "22655b71-76f4-4064-a85e-2fb4a0e8e209"
      }
    },
    "owner": "myk-ull"
  }
}
